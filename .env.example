# ===========================================================
# ErgoSolutions - Variables de entorno
# ===========================================================
# Copiar este archivo a .env y completar los valores.
# NUNCA commitear el archivo .env al repositorio.
# ===========================================================

# --- Core Django ---
SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# CSP bloqueante; usar True sólo para una observación diagnóstica temporal.
CSP_REPORT_ONLY=False

# --- Database ---
DATABASE_URL=postgres://USER:PASSWORD@127.0.0.1:5432/ergocapacitacion

# --- Email ---
# Backend: console para desarrollo, smtp para produccion
# django.core.mail.backends.console.EmailBackend  (dev - imprime en terminal)
# django.core.mail.backends.smtp.EmailBackend     (prod - envia email real)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# SMTP (solo necesario cuando EMAIL_BACKEND=...smtp.EmailBackend)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=tu-email@gmail.com
EMAIL_HOST_PASSWORD=tu-app-password-de-gmail

# Remitente que aparece en los emails
DEFAULT_FROM_EMAIL=ErgoSolutions <tu-email@gmail.com>

# Para emails de error de Django (opcional, usa DEFAULT_FROM_EMAIL si no se define)
# SERVER_EMAIL=tu-email@gmail.com

# Admin que recibe copia de cada certificado
ADMIN_EMAIL=admin@example.com

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini-2025-08-07

# ===========================================================
# Módulo de Ergonomía SRT 886/15
# ===========================================================
# Modelo del módulo. Si se omite, usa OPENAI_MODEL.
# CHAT_AI_MODEL=

# Chat de ayuda contextual
CHAT_AI_AGENT_CACHE_SIZE=64
CHAT_AI_RATE_LIMIT=20
CHAT_AI_RATE_WINDOW_SECONDS=60
CHAT_AI_STREAM_TIMEOUT_SECONDS=120
CHAT_AI_HEARTBEAT_SECONDS=10
CHAT_AI_MAX_QUESTION_CHARS=2000
CHAT_AI_MAX_THREAD_MESSAGES=20
CHAT_AI_MAX_MESSAGE_CHARS=4000

# Informes profesionales con modelo de lenguaje
REPORT_AI_TIMEOUT_SECONDS=90
REPORT_AI_RATE_LIMIT=10
REPORT_AI_RATE_WINDOW_SECONDS=3600

# Descarga de documentos oficiales
EXPORT_RATE_LIMIT=60
EXPORT_RATE_WINDOW_SECONDS=300
